NODE_ENV=development
JWT_SECRET=change-me-in-production
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=7d
DATABASE_URL=postgresql://user:password@localhost:5433/sleeptracker
PORT=8000
DB_SYNCHRONIZE=false
DB_MIGRATIONS_RUN=false
ADMIN_EMAIL=admin@taquaralto.com
ADMIN_PASSWORD=change-me
# Origens permitidas separadas por vírgula (sem "/" no final)
# Ex: http://localhost:5173,https://taquaraltofutsal.mvflow.com.br
CORS_ORIGIN=http://localhost:5173
AUTH_RATE_LIMIT_MAX=20
